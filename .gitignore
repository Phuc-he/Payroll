===shipping_policies
Các chính sách vận chuyển: của seller đặt ra, tên, phí, loại giảm giá [REDUCE, FREE]
min_order_free: giá trị nhỏ nhất cần đạt được để áp dụng ship FREE


==shipping_policy_reduces
Các vùng giảm giá: Dựa vào giá trị đơn hàng => Giảm giá bao nhiêu
min_order_value: Giá trị đơn hàng cần đạt tối thiểu
ship_fee: mức phí vận chuyển khi đơn hàng >= min_order_value

==shipping_policy_areas
Các địa chỉ được áp dụng chính sách vận chuyển
Tỉnh, Xã (có response ra id ko)

==>Khi search thì Fe: tìm kiếm theo danh sách api trả về (tỉnh + huyện)
==>Khi submit tìm kiếm thì truyền id tỉnh, huyện xuống (1 thành phố, nhiều huyện)

===Xóa policy thì ảnh hưởng xóa địa chỉ ở admin; => ko được xóa khi đang áp dụng vận chuyển ở farm






===========  https://git.gm-group.vn/viettel-f2r/cif-service/-/merge_requests/351    ================


==database===

CREATE TABLE `b2b_shipping_policies` (
  `id` char(32) PRIMARY KEY,
  `seller_id` char(32) COMMENT 'Id của seller',
  `name` varchar(255) CHARACTER SET utf8mb3 COLLATE utf8mb3_bin NOT NULL COMMENT 'Tên của chính sách vận chuyển do NCC đặt',
  `base_fee` bigint NOT NULL COMMENT 'Phí vận chuyển cơ bản (bắt buộc > 0). Áp dụng mặc định cho các khu vực thuộc chính sách',
  `discount_type` varchar(10) NOT NULL COMMENT 'Loại ưu đãi phí vận chuyể. ENUM: NONE = không ưu đãi, FREE = miễn phí khi đạt ngưỡng, REDUCE = giảm phí theo bậc giá trị đơn hàng',
  `min_order_free` bigint COMMENT 'Ngưỡng giá trị đơn hàng để được miễn phí vận chuyển (chỉ dùng khi discount_type = FREE)',
  `created_at` datetime NOT NULL DEFAULT (CURRENT_TIMESTAMP),
  `updated_at` datetime DEFAULT null ON UPDATE CURRENT_TIMESTAMP,
  `created_by` CHAR(32),
  `updated_by` CHAR(32)
);


CREATE INDEX `created_at_idx` ON `b2b_shipping_policies` (`created_at`);

CREATE INDEX `updated_at_idx` ON `b2b_shipping_policies` (`updated_at`);

CREATE INDEX `b2b_shipping_policies_index_87` ON `b2b_shipping_policies` (`seller_id`);

CREATE INDEX `b2b_shipping_policies_index_88` ON `b2b_shipping_policies` (`discount_type`);

ALTER TABLE `b2b_shipping_policies` COMMENT = 'Bảng lưu thông tin cấu hình chính của chính sách vận chuyển, bao gồm phí cơ bản và loại hình ưu đãi áp dụng';

CREATE TABLE `b2b_shipping_policy_areas` (
  `id` char(32) PRIMARY KEY,
  `shipping_policy_id` char(32) NOT NULL COMMENT 'ID của chính sách vận chuyển liên kết',
  `province_id` char(32) NOT NULL COMMENT 'ID của Tỉnh/Thành phố áp dụng chính sách',
  `ward_id` char(32) NOT NULL COMMENT 'ID của Phường/Xã áp dụng chính sách',
  `created_at` datetime NOT NULL DEFAULT (CURRENT_TIMESTAMP),
  `updated_at` datetime DEFAULT null ON UPDATE CURRENT_TIMESTAMP,
  `created_by` CHAR(32),
  `updated_by` CHAR(32)
);

CREATE INDEX `created_at_idx` ON `b2b_shipping_policy_areas` (`created_at`);

CREATE INDEX `updated_at_idx` ON `b2b_shipping_policy_areas` (`updated_at`);

CREATE UNIQUE INDEX `uq_policy_ward` ON `b2b_shipping_policy_areas` (`id`, `ward_id`);

ALTER TABLE `b2b_shipping_policy_areas` COMMENT = 'Bảng ánh xạ giữa chính sách vận chuyển và các khu vực hành chính (phường/xã) mà chính sách được áp dụng. Một phường chỉ thuộc một chính sách của NCC.';



CREATE TABLE `b2b_shipping_policy_reduces` (
  `id` char(32) PRIMARY KEY,
  `shipping_policy_id` char(32) NOT NULL COMMENT 'ID của chính sách vận chuyển liên kết',
  `min_order_value` char(32) NOT NULL COMMENT 'Giá trị đơn hàng tối thiểu để áp dụng mức phí này',
  `shipping_fee` bigint NOT NULL COMMENT 'Mức phí vận chuyển tương ứng với giá trị đơn hàng ≥ min_order_value',
  `created_at` datetime NOT NULL DEFAULT (CURRENT_TIMESTAMP),
  `updated_at` datetime DEFAULT null ON UPDATE CURRENT_TIMESTAMP,
  `created_by` CHAR(32),
  `updated_by` CHAR(32)
);

CREATE INDEX `created_at_idx` ON `b2b_shipping_policy_reduces` (`created_at`);

CREATE INDEX `updated_at_idx` ON `b2b_shipping_policy_reduces` (`updated_at`);

CREATE INDEX `shipping_policy_reduces_index_94` ON `b2b_shipping_policy_reduces` (`shipping_policy_id`);

CREATE UNIQUE INDEX `uq_policy_min_order` ON `b2b_shipping_policy_reduces` (`id`, `min_order_value`);

ALTER TABLE `b2b_shipping_policy_reduces` COMMENT = 'Bảng lưu danh sách các mức giảm phí vận chuyển theo giá trị đơn hàng, chỉ áp dụng khi chính sách có discount_type = REDUCE.';

